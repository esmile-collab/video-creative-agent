{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-card.schema.json",
  "title": "公开策略卡",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_card_schema_version",
    "strategy_card_id",
    "strategy_card_version",
    "script_type",
    "status",
    "strategy_name",
    "strategy_summary",
    "retrieval_view",
    "generation_view",
    "transfer_boundary",
    "source_refs"
  ],
  "properties": {
    "strategy_card_schema_version": { "const": "strategy_card_v1" },
    "strategy_card_id": { "type": "string", "minLength": 1 },
    "strategy_card_version": { "type": "string", "minLength": 1 },
    "script_type": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "reviewed", "published", "retired"]
    },
    "strategy_name": { "type": "string", "minLength": 1 },
    "strategy_summary": { "type": "string", "minLength": 1 },
    "retrieval_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience_situations",
        "problem_patterns",
        "content_goals",
        "product_tasks",
        "required_inputs",
        "exclusion_conditions"
      ],
      "properties": {
        "audience_situations": { "$ref": "#/$defs/string_array" },
        "problem_patterns": { "$ref": "#/$defs/string_array" },
        "content_goals": { "$ref": "#/$defs/string_array" },
        "product_tasks": { "$ref": "#/$defs/string_array" },
        "required_inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclusion_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition_id", "description"],
            "properties": {
              "condition_id": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "generation_view": {
      "type": "object",
      "required": [
        "opening_strategy",
        "attention_to_product",
        "semantic_structure",
        "mechanism_pattern",
        "narrator_profile",
        "language_style"
      ],
      "properties": {
        "opening_strategy": { "type": "object" },
        "attention_to_product": { "type": "object" },
        "semantic_structure": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "object" }
        },
        "mechanism_pattern": { "type": "object" },
        "narrator_profile": {
          "type": "object",
          "required": ["dramatization_permission", "core_fact_boundary"],
          "properties": {
            "dramatization_permission": { "type": "string", "minLength": 1 },
            "core_fact_boundary": { "type": "string", "minLength": 1 }
          }
        },
        "language_style": { "type": "object" }
      }
    },
    "transfer_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": { "$ref": "#/$defs/string_array" },
        "forbidden": { "$ref": "#/$defs/string_array" }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "evidence_note"],
        "properties": {
          "source_id": { "type": "string" },
          "evidence_note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

